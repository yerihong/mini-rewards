    "firebase-admin": "^13.10.0",
    "firebase-functions": "^5.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^26.1.2",
    "typescript": "^5.8.3"
  },
  "private": true
}
