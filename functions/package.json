{
  "name": "functions",
  "version": "1.0.0",
  "description": "Mini rewards API for HeyMax take-home",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
